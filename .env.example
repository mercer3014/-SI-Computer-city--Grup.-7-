APP_NAME="Computer City"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE="America/La_Paz"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local / pruebas: Postgres de la máquina (tiendaDB).
#DB_CONNECTION=
#DB_HOST=
#DB_PORT=
#DB_DATABASE=
#DB_USERNAME=
#DB_PASSWORD=
#DB_SSLMODE=prefer

# Producción: 
#SUPABASE_DB_HOST=
#SUPABASE_DB_PORT=
#SUPABASE_DB_DATABASE=postgres
#SUPABASE_DB_USERNAME=
#SUPABASE_DB_PASSWORD=
#SUPABASE_DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Local con correo real (clave temporal de usuarios, recuperar cuenta): Gmail SMTP con App Password.
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SCHEME=null
# MAIL_USERNAME=tu.correo@gmail.com
# MAIL_PASSWORD="xxxx xxxx xxxx xxxx"
# MAIL_FROM_ADDRESS="tu.correo@gmail.com"

# Producción (Render): API de Brevo, no Gmail SMTP.
#BREVO_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Clave de los usuarios de demostración (php artisan migrate:fresh --seed). Solo desarrollo.
SEED_DEMO_PASSWORD=password

# Asistente virtual (CU22) – API de Grok (xAI). Nunca subas la clave al repo.
# XAI_MODEL queda vacío para que lo elijas con `php artisan asistente:modelos`.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=
XAI_TIMEOUT=20
ASISTENTE_LIMITE_POR_MINUTO=10
# Solo local y pruebas: respuestas de demostración sin llamar a xAI.
ASISTENTE_SIMULADO=false

# Cotizaciones web (CU19): días de vigencia y código de país para el enlace de WhatsApp.
TIENDA_DIAS_VALIDEZ_COTIZACION=7
TIENDA_CODIGO_PAIS=591

# Solo para las capturas de validación (scripts/capturas-ciclo4.mjs): simula el dictado por voz.
# Nunca en producción; se define al compilar: VITE_DICTADO_SIMULADO=true pnpm run build
# VITE_DICTADO_SIMULADO=false

VITE_APP_NAME="${APP_NAME}"
